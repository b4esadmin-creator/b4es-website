{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // B4ES Ledger: private bookkeeping app on ledger.b4es.co.uk.
  // Separate from the public site on purpose (own Worker, own database).
  "name": "b4es-ledger",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-21",

  // Every request goes through the Worker first, so the Access login check
  // runs before any page or file is served.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b4es-ledger",
      "database_id": "0337cef9-4f9e-4f97-a736-55e7b1d991e4",
      "migrations_dir": "./migrations"
    }
  ],

  // Supporting documents (any file up to 25 MB). The EU bucket is created by
  // ledger-deploy.yml if it does not exist yet.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "b4es-ledger-documents", "jurisdiction": "eu" }],

  "vars": {
    // Cloudflare Access. Until both are filled in the app shows
    // "set-up pending" and serves nothing. Neither value is secret.
    //   TEAM_DOMAIN: https://<team>.cloudflareaccess.com
    //   POLICY_AUD:  the Access application's "Application Audience (AUD) Tag"
    "TEAM_DOMAIN": "https://damp-mode-0f67.cloudflareaccess.com",
    "POLICY_AUD": "b9e5822c0bc06e3fe0447bfa568f1e4cb50237bc55166231ee3ebd26329d6083",
    // Signed-in emails that get the admin role on first sign-in.
    "ADMIN_EMAILS": "b4es.admin@gmail.com",
    // Client IDs of the Access service tokens that act as Claude (comma
    // separated). Claude may only read the books and send entries for
    // approval. The Client ID is an identifier; the Client Secret stays in
    // each partner's Claude environment and never goes in this repo.
    "AGENT_CLIENT_IDS": "75f9feb9b1f75e9c195cb0e5b331aabc.access"
  },

  // Only the custom domain, which sits behind Cloudflare Access. The
  // workers.dev and preview URLs would bypass Access, so they are off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ledger.b4es.co.uk", "custom_domain": true }],

  "observability": { "enabled": true }
}
