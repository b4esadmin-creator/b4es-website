{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers static assets.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  //
  // This project has no Worker script — it is assets only — so there is
  // deliberately no "main" and no assets "binding".

  "name": "b4es-website",
  "compatibility_date": "2026-08-21",

  "assets": {
    // Build output only. Nothing else in the repo is ever uploaded.
    "directory": "./dist",

    // Serve the nearest 404.html for unmatched paths (this is a static site,
    // not a single-page app).
    "not_found_handling": "404-page",

    // /about -> /about/ ; matches the directory-per-page output of build.mjs
    // and the canonical URLs baked into each page.
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }

  // CUSTOM DOMAIN
  // Leave routes out of this file and attach the domain once in the dashboard
  // (Workers & Pages -> b4es-website -> Settings -> Domains & Routes -> Add
  // custom domain). Cloudflare then creates the DNS record and manages the
  // certificate. Alternatively, uncomment and set:
  //
  // "routes": [
  //   { "pattern": "example.co.uk", "custom_domain": true },
  //   { "pattern": "www.example.co.uk", "custom_domain": true }
  // ]
}
