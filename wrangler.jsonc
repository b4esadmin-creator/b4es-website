{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers static assets.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  //
  // This project has no Worker script — it is assets only — so there is
  // deliberately no "main" and no assets "binding".

  "name": "b4es-website",
  "compatibility_date": "2026-08-21",

  // The Worker only handles /api/*. Every page and asset on the site is served
  // straight from the asset store and never invokes Worker code.
  "main": "./worker/index.js",

  "assets": {
    // Build output only. Nothing else in the repo is ever uploaded.
    "directory": "./dist",

    // Serve the nearest 404.html for unmatched paths (this is a static site,
    // not a single-page app).
    "not_found_handling": "404-page",

    // /about -> /about/ ; matches the directory-per-page output of build.mjs
    // and the canonical URLs baked into each page.
    "html_handling": "auto-trailing-slash",

    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Durable store for contact-form enquiries. Written before any notification
  // is attempted, so an email outage cannot lose an enquiry.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b4es-enquiries",
      "database_id": "07d5d58b-cd60-44d3-9027-ea72fd8a6c7b",
      "migrations_dir": "./migrations"
    }
  ],

  // Cloudflare Email Service. Sending to a verified Email Routing destination
  // is free on every plan, so enquiry notifications cost nothing and involve
  // no third-party processor.
  //
  // REQUIRES (one-time, in the dashboard):
  //   1. Email Routing enabled on the b4es.co.uk zone
  //   2. the destination address below verified
  // Until then the Worker still stores every enquiry; it just records
  // notified = 0 against the row.
  "send_email": [
    {
      "name": "ENQUIRY_EMAIL",
      "destination_address": "info@b4es.co.uk"
    }
  ],

  "vars": {
    // Sender must be on a domain onboarded to Email Routing.
    "ENQUIRY_FROM": "website@b4es.co.uk",
    // Must match the binding's destination_address above.
    "ENQUIRY_TO": "info@b4es.co.uk"
  },

  "observability": {
    "enabled": true
  },

  // CUSTOM DOMAIN
  //
  // Both hostnames are attached so neither 404s. Cloudflare creates the DNS
  // records and manages the certificates on first deploy; the zone must
  // already exist in the same Cloudflare account.
  //
  // Canonical URLs, Open Graph tags and sitemap.xml all point at the apex
  // (set by baseUrl in src/data/site.mjs), so the apex is the canonical host.
  // For cleanliness, add a zone Redirect Rule sending www -> apex; it runs at
  // the edge before the Worker and is cheaper than serving both.
  //
  // If the zone is not yet in this Cloudflare account, delete this block,
  // deploy to the workers.dev subdomain first, and attach the domain later
  // from Workers & Pages -> b4es-website -> Settings -> Domains & Routes.
  "routes": [
    { "pattern": "b4es.co.uk", "custom_domain": true },
    { "pattern": "www.b4es.co.uk", "custom_domain": true }
  ]
}
